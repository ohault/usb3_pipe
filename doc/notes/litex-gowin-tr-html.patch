@@ -162,6 +163,75 @@ def parse_gowin_timing(report, max_paths=10):
     timing["met"] = all(c["met"] for c in timing["clocks"]) and (timing["tns"] == 0)
     return timing
 
+def _html_text(s):
+    s = re.sub(r"<[^>]+>", "", s)
+    for a, b in [("&lt;", "<"), ("&gt;", ">"), ("&nbsp;", " "), ("&amp;", "&")]:
+        s = s.replace(a, b)
+    return s.strip()
+
+def _html_rows(html):
+    """Table rows (lists of cell texts) of an HTML fragment."""
+    rows = []
+    for row in re.findall(r"<tr[^>]*>(.*?)</tr>", html, re.S | re.I):
+        cells = [_html_text(c) for c in re.findall(r"<t[dh][^>]*>(.*?)</t[dh]>", row, re.S | re.I)]
+        if cells:
+            rows.append(cells)
+    return rows
+
+def _html_section(html, name):
+    """HTML from the <a name="name"> heading to the next <h2> heading."""
+    m = re.search(rf'<a\s+name="{re.escape(name)}"', html)
+    if not m:
+        return ""
+    n = re.search(r"<h2", html[m.end():], re.I)
+    return html[m.end():m.end() + n.start()] if n else html[m.end():]
+
+def parse_gowin_timing_html(report, max_paths=10):
+    """Parse a Gowin HTML timing report (project_tr_content.html, Gowin 1.9.12 tools: project.tr.html
+    is a frameset around it)."""
+    timing = {"clocks": [], "worst_paths": []}
+    for cells in _html_rows(_html_section(report, "Max_Frequency_Report")):
+        if len(cells) >= 5 and _int(cells[0]) is not None:
+            constraint = _float(cells[2].replace("(MHz)", ""))
+            fmax       = _float(cells[3].replace("(MHz)", ""))
+            if constraint is None or fmax is None:
+                continue
+            timing["clocks"].append({
+                "clock"         : cells[1],
+                "constraint_mhz": constraint,
+                "fmax_mhz"      : fmax,
+                "logic_levels"  : _int(cells[4]),
+                "met"           : fmax >= constraint,
+            })
+    tns = {}
+    for cells in _html_rows(_html_section(report, "Total_Negative_Slack_Report")):
+        if len(cells) == 4 and _float(cells[2]) is not None:
+            tns[(cells[0], cells[1].lower())] = (_float(cells[2]), _int(cells[3]))
+    for clock in timing["clocks"]:
+        clock["tns"], clock["failing_endpoints"] = tns.get((clock["clock"], "setup"), (None, None))
+    timing["tns"] = sum(v[0] for (c, t), v in tns.items() if t == "setup")
+    setup = _html_section(report, "Setup_Analysis") or report
+    for m in re.finditer(r"Path Summary:.*?(<table.*?</table>)", setup, re.S | re.I):
+        fields = {cells[0]: cells[1] for cells in _html_rows(m.group(1)) if len(cells) >= 2}
+        if _float(fields.get("Slack")) is None:
+            continue
+        path = {"slack": _float(fields["Slack"])}
+        for key, label in [("from", "From"), ("to", "To"), ("launch_clock", "Launch Clk"),
+            ("latch_clock", "Latch Clk")]:
+            if label in fields:
+                path[key] = fields[label]
+        timing["worst_paths"].append(path)
+        if len(timing["worst_paths"]) >= max_paths:
+            break
+    # WNS from the per clock Fmax (the setup path list also holds unconstrained clock crossings,
+    # ex: sys_clk -> JTAG TCK paths of negative slack on a build meeting timing).
+    slacks = [1e3/c["constraint_mhz"] - 1e3/c["fmax_mhz"] for c in timing["clocks"] if c["fmax_mhz"]]
+    if not slacks:
+        slacks = [p["slack"] for p in timing["worst_paths"]]
+    timing["wns"] = round(min(slacks), 3) if slacks else None
+    timing["met"] = all(c["met"] for c in timing["clocks"]) and (timing["tns"] == 0)
+    return timing
+
 def parse_gowin_utilization(report):
     """Parse the Resource Usage Summary of a Gowin report (project.rpt.txt)."""
     utilization = []
@@ -381,9 +451,13 @@ def parse_build_reports(output_dir, max_paths=10):
     # Gowin.
     gowin_tr  = os.path.join(gateware_dir, "impl", "pnr", "project.tr")
     gowin_rpt = os.path.join(gateware_dir, "impl", "pnr", "project.rpt.txt")
+    gowin_tr_html = os.path.join(gateware_dir, "impl", "pnr", "project_tr_content.html")
     if os.path.exists(gowin_tr):
         r["toolchain"] = "gowin"
         r["timing"]    = parse_gowin_timing(_read(gowin_tr), max_paths)
+    elif os.path.exists(gowin_tr_html):
+        r["toolchain"] = "gowin"
+        r["timing"]    = parse_gowin_timing_html(_read(gowin_tr_html), max_paths)
     if os.path.exists(gowin_rpt):
         r["utilization"] = parse_gowin_utilization(_read(gowin_rpt))
 
