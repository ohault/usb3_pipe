@@ -243,6 +279,26 @@ class TestReport(unittest.TestCase):
         u = parse_gowin_utilization(GOWIN_UTILIZATION)
         self.assertEqual([r["resource"] for r in u], ["Logic", "Register", "BSRAM"])
 
+    def test_gowin_html(self):
+        # Gowin 1.9.12: HTML report; timing met per clock (TNS 0) with a negative slack path to the
+        # JTAG TCK (not a constrained clock) at the head of the setup path list.
+        t = parse_gowin_timing_html(GOWIN_TIMING_HTML)
+        self.assertEqual([c["clock"] for c in t["clocks"]], ["sys_clk", "usb3_serdes_tx_clk"])
+        self.assertEqual(t["clocks"][1]["fmax_mhz"], 125.213)
+        self.assertEqual(t["clocks"][1]["failing_endpoints"], 0)
+        self.assertEqual(t["tns"], 0)
+        self.assertTrue(t["met"])
+        self.assertEqual(t["wns"], 0.014) # From the clocks Fmax, not the JTAG TCK path (-5.905).
+        self.assertEqual([p["slack"] for p in t["worst_paths"]], [-5.905, 0.042])
+        self.assertEqual(t["worst_paths"][0]["latch_clock"], "jtagbone_phy_gowinjtag_new_tck7:[R]")
+        with tempfile.TemporaryDirectory() as d:
+            os.makedirs(os.path.join(d, "gateware", "impl", "pnr"))
+            with open(os.path.join(d, "gateware", "impl", "pnr", "project_tr_content.html"), "w") as f:
+                f.write(GOWIN_TIMING_HTML)
+            r = parse_build_reports(d)
+            self.assertEqual(r["toolchain"], "gowin")
+            self.assertTrue(r["timing"]["met"])
